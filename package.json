{
  "name": "humanlens",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Human Lens — AI-assisted qualitative-synthesis tool (Module 1: the Listening Brief).",
  "workspaces": [
    "packages/shared",
    "packages/backend",
    "packages/frontend"
  ],
  "scripts": {
    "build": "tsc -b packages/shared packages/backend",
    "clean": "tsc -b --clean packages/shared packages/backend",
    "test": "npm run test --workspaces --if-present",
    "lint:js": "eslint \"packages/**/*.ts\"",
    "lint:css": "stylelint \"packages/*/src/**/*.css\"",
    "lint": "npm run lint:js && npm run lint:css"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "stylelint": "^16.12.0",
    "stylelint-config-standard": "^36.0.1",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.1"
  }
}
