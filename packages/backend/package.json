{
  "name": "@humanlens/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "clean": "tsc -b --clean",
    "test": "vitest run",
    "eval": "tsc -b && node --env-file-if-exists=.env dist/eval/run-lens.js",
    "completeness": "tsc -b && node dist/eval/completeness/run-completeness.js",
    "cross-voice": "tsc -b && node dist/eval/run-cross-voice.js",
    "f1a": "tsc -b && node --env-file-if-exists=.env dist/eval/completeness/real/f1a-silent-drop.js",
    "f1b": "tsc -b && node --env-file-if-exists=.env dist/eval/completeness/real/f1b-star.js",
    "f2": "tsc -b && node --env-file-if-exists=.env dist/eval/completeness/real/f2-cache.js",
    "f3": "tsc -b && node --env-file-if-exists=.env dist/eval/completeness/real/f3-walltime.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.106.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^6.0.0",
    "@humanlens/shared": "*",
    "awilix": "^13.0.5",
    "fastify": "^5.8.5"
  },
  "devDependencies": {
    "@types/node": "^22.19.21",
    "@vitest/coverage-v8": "^2.1.9",
    "fast-check": "^4.9.0",
    "vitest": "^2.1.9"
  }
}
